# Salin jadi `.env` lalu isi. JANGAN commit `.env`.

# ── Gambar GHCR (nama image dari workflow docker-publish.yml) ──
# ganti {ORG}/{REPO} sesuai repository GitHub-mu, contoh:
#   ghcr.io/novinardianyulianto/strapi-next-monorepo-starter-strapi
IMAGE_STRAPI=ghcr.io/{ORG}/{REPO}-strapi:latest
IMAGE_UI=ghcr.io/{ORG}/{REPO}-ui:latest

# ── URL publik ──
UI_PUBLIC_URL=https://www.domain-anda.com
STRAPI_PUBLIC_URL=https://cms.domain-anda.com

# ── Database ──
POSTGRES_USER=strapi
POSTGRES_PASSWORD=ganti-password-kuat
POSTGRES_DB=strapi-db

# ── Secret Strapi (generate sekali, simpan aman) ──
#   openssl rand -base64 32
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=

# ── Revalidasi cache (HARUS sama di Strapi & UI) ──
STRAPI_REVALIDATE_SECRET=
STRAPI_CDN_PURGE_SECRET=

# ── API token Strapi utk UI ──
# Bikin di cms.domain-anda.com/admin → Settings → API Tokens:
#  - "Read Only" → isi STRAPI_REST_READONLY_API_KEY
#  - (opsional) "Custom" utk write lewat proxy → STRAPI_REST_CUSTOM_API_KEY
STRAPI_REST_READONLY_API_KEY=
STRAPI_REST_CUSTOM_API_KEY=

# ── Auth end-user (opsional, kalau fitur login dipakai) ──
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Upload object storage (opsional) ──
# Kosongkan semua → media disimpan di volume Docker `uploads` (local).
# AWS S3 / R2 / Backblaze B2 / DO Spaces / MinIO (S3-compatible):
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=
AWS_BUCKET=
# Contoh endpoint: https://<account-id>.r2.cloudflarestorage.com (R2),
#                  https://s3.us-west-004.backblazeb2.com (B2),
#                  https://<region>.digitaloceanspaces.com (Spaces),
#                  http://minio:9000 (MinIO)
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=false

# ── Seed baseline (opsional, first-boot saja) ──
AUTO_SEED_ENABLED=false
AUTO_SEED_MODE=empty