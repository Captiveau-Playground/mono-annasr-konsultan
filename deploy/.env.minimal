# ─────────────────────────────────────────────────────────────
#  .env MINIMAL untuk deploy pertama — isi 9 hal ini saja.
#  (Opsional lainnya bisa dikosongkan; lihat .env.example utk lengkap)
#
#  Cara buat secret (di terminal):
#    openssl rand -base64 32        # jalankan 1x utk APP_KEYS
#    openssl rand -base64 32        # jalankan 1x utk API_TOKEN_SALT
#    openssl rand -base64 32        # jalankan 1x utk ADMIN_JWT_SECRET
#    openssl rand -base64 32        # jalankan 1x utk JWT_SECRET
#    openssl rand -base64 32        # jalankan 1x utk STRAPI_REVALIDATE_SECRET
# ─────────────────────────────────────────────────────────────

# 1. Image (sudah ada di GHCR setelah build)
IMAGE_STRAPI=ghcr.io/Captiveau-Playground/mono-annasr-konsultan-strapi:latest
IMAGE_UI=ghcr.io/Captiveau-Playground/mono-annasr-konsultan-ui:latest

# 2. URL publik (domains — kalau belum ada, isi placeholder http://localhost dulu)
UI_PUBLIC_URL=https://www.domain-anda.com
STRAPI_PUBLIC_URL=https://cms.domain-anda.com

# 3. Database (bebas ganti password)
POSTGRES_USER=admin
POSTGRES_PASSWORD=ganti-saya-123
POSTGRES_DB=strapi-db

# 4. Secret Strapi (wajib, gunakan hasil openssl di atas)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=

# 5. Revalidasi cache — harus SAMA di ui & strapi (compose memakai 1 nilai utk keduanya)
STRAPI_REVALIDATE_SECRET=

# Bisa kosong aman: STRAPI_REST_READONLY_API_KEY, GTM_ID, MS_CLARITY_ID,
# STRAPI_REST_CUSTOM_API_KEY, BETTER_AUTH_SECRET, TRANSFER_TOKEN_SALT.
# Jangan lupa ganti UI_PUBLIC_URL/STRAPI_PUBLIC_URL setelah domain jalan.